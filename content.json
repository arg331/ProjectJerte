            "Entries": {
                // ID 99112255 / 4 Corazones / Viernes (días 5,12,19,26) / Tarde / Abigail, Sam, Seb presentes
                "99112255/f Miguel 1000/d Fri/t 1700 2200": "content/30 20/farmer 23 19 1 Miguel 19 21 1 Gus 10 18 1 Sam 32 19 3 Sebastian 31 19 3 Abigail 33 20 0/skippable/pause 1000/speak Sam \"¡Vamos, vamos! ¡Cúbreme por la izquierda!\"/speak Abigail \"¡Estoy en ello! ¡Sebastian, eres un manco!\"/pause 500/playSound arcade_game_over/pause 500/speak Sebastian \"...Se ha quedado pillado.\"/emote Sam 28/speak Sam \"¡¿Qué?! ¡No! ¡Estábamos a punto de batir el récord!\"/move farmer 7 0 1/speak Abigail \"Genial. Pantallazo azul. Gus va a tardar semanas en llamar al técnico.\"/move Miguel 10 0 1/speak Miguel \"Perdonad... ¿puedo echar un vistazo?\"/faceDirection Sebastian 3/speak Sebastian \"Oh, hola Miguel. Se ha frito la placa, creo.\"/speak Miguel \"Mmm... no huele a quemado.\"/move Miguel 3 -1 1/pause 500/animate Miguel false true 200 20 21 22/playSound clank/pause 400/playSound clank/speak Miguel \"Ah, vale, sé lo que es, es un desbordamiento. Pasa mucho en estos modelos de los 90.\"/pause 500/stopAnimation Miguel/playSound arcade_game_over/speak Miguel \"Creo que con un puentecillo tonto...\"/pause 1000/playSound reward/emote Sam 16/speak Sam \"¡Funciona! ¡ESTÁ VIVOO!\"/faceDirection Miguel 2/speak Miguel \"Listo. Y de paso os he desbloqueado el modo debug. Ahora tenéis vidas infinitas si pulsáis los dos botones a la vez.\"/emote Abigail 20/speak Abigail \"Vale, eso ha estado muy muy chulo.\"/speak Sebastian \"Nada mal para alguien que trabaja en 'Indalia', eso es todo desierto.\"/speak Miguel \"El código es código, da igual si es para una multinacional o para matar orcos.\"/speak Gus \"¡Miguel! ¡Deja de hackear mis máquinas o te cobro las birras desgraciado!\"/emote Miguel 40/speak Miguel \"¡Era una mejora de software, primo!\"/end"
            }
